# サンプルを実際に動かすときに使うキー（テスト `npm test` は偽のモデルを使うので不要）

# Anthropic（Claude。全章）
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI（第4・8章の埋め込み、第2・3・8章のモデル切り替え、第1・7章の OpenAI Agents）
OPENAI_API_KEY=sk-xxx

# Langfuse（第6章 観測性）
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostgreSQL + pgvector（第4章の本番構成・第8章の Semantic Cache）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents

# Redis（第8章のキャッシュ）
REDIS_URL=redis://localhost:6379

# GitHub の MCP サーバー（第3章）
GITHUB_TOKEN=ghp_xxx
